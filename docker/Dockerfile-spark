# Use Bitnami Spark base image for consistency with your compose file
FROM bitnami/spark:3.3.2

USER root

# Install Python3-pip and other tools needed for Spark ETL
RUN apt-get update && apt-get install -y python3 python3-pip wget curl unzip build-essential \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install Python packages needed
RUN pip3 install --no-cache-dir kafka-python pandas requests psycopg2-binary

# Download PostgreSQL JDBC driver (if needed by your Spark app)
RUN wget -O /opt/postgresql-42.2.18.jar https://jdbc.postgresql.org/download/postgresql-42.2.18.jar

# Download Spark Kafka connector JAR
RUN mkdir -p /opt/spark/jars && \
    wget -O /opt/spark/jars/spark-sql-kafka-0-10_2.12-3.3.2.jar \
    https://repo1.maven.org/maven2/org/apache/spark/spark-sql-kafka-0-10_2.12/3.3.2/spark-sql-kafka-0-10_2.12-3.3.2.jar

# Copy your Spark app and kafka scripts
COPY ./spark /app/spark
COPY ./kafka /app/kafka

WORKDIR /app/spark

CMD ["spark-submit", "--packages", "org.apache.spark:spark-sql-kafka-0-10_2.12:3.3.2", "stream_etl.py"]
