# ✅ Base image with Java, Spark, and Hadoop
FROM bitnami/spark:3.3.2

# 👤 Use root user for installation
USER root

# 🗂️ Set working directory
WORKDIR /app

# 🔧 Install required tools and Python pip
RUN apt-get update && \
    apt-get install -y python3-pip wget curl unzip && \
    apt-get clean

# 🐍 Install Python dependencies
RUN pip3 install --no-cache-dir kafka-python pandas requests psycopg2-binary

# 📥 Download PostgreSQL JDBC driver
RUN wget -O /opt/postgresql-42.2.18.jar https://jdbc.postgresql.org/download/postgresql-42.2.18.jar

# 🔌 Download Spark-Kafka connector + Kafka clients
RUN mkdir -p /opt/spark/jars && \
    wget -O /opt/spark/jars/spark-sql-kafka-0-10_2.12-3.3.2.jar https://repo1.maven.org/maven2/org/apache/spark/spark-sql-kafka-0-10_2.12/3.3.2/spark-sql-kafka-0-10_2.12-3.3.2.jar && \
    wget -O /opt/spark/jars/kafka-clients-3.2.0.jar https://repo1.maven.org/maven2/org/apache/kafka/kafka-clients/3.2.0/kafka-clients-3.2.0.jar

# 🔧 Set classpath for custom JARs
ENV SPARK_CLASSPATH="/opt/spark/jars/*:/opt/postgresql-42.2.18.jar"

# 📁 Copy ETL and Kafka code into the container
COPY spark/ /app/spark/
COPY kafka/ /app/kafka/

# 🏁 Default command (can be overridden)
CMD ["/bin/bash"]
